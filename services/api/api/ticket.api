// API DSL reference: https://go-zero.dev/reference/api-dsl/
syntax = "v1"

type Ticket {
	ID          string `json:"id"`
	Title       string `json:"title"`
	Description string `json:"description"`
	Status      string `json:"status"`
	CreatedAt   string `json:"createdAt"`
}

type TicketListResponse {
	Tickets []Ticket `json:"tickets"`
}

type UpdateTicketStatusInput {
	Status string `json:"status"`
}

service nexus-api {
	@handler listTickets
	get /tickets returns (TicketListResponse)

	@handler updateTicketStatus
	patch /tickets/:id/status (UpdateTicketStatusInput) returns (Ticket)
}
