// API DSL reference: https://go-zero.dev/reference/api-dsl/
syntax = "v1"

type LoginInput {
	Username string `json:"username"`
	Password string `json:"password"`
}

type RegisterInput {
	Username string `json:"username"`
	Password string `json:"password"`
}

type LoginResponse {
	Token    string `json:"token"`
	Username string `json:"username"`
	Role     string `json:"role"`
}

type GithubLoginResponse {
	RedirectURL string `json:"redirectUrl"`
	State       string `json:"state"`
}

type GithubCallbackInput {
	Code  string `form:"code"`
	State string `form:"state"`
}

type GithubCallbackResponse {
	RedirectURL string `json:"redirectUrl"`
}

type GiteeLoginResponse {
	RedirectURL string `json:"redirectUrl"`
	State       string `json:"state"`
}

type GiteeCallbackInput {
	Code  string `form:"code"`
	State string `form:"state"`
}

type GiteeCallbackResponse {
	RedirectURL string `json:"redirectUrl"`
}

service nexus-api {
	@handler login
	post /auth/login (LoginInput) returns (LoginResponse)

	@handler register
	post /auth/register (RegisterInput) returns (LoginResponse)

	@handler githubLogin
	get /auth/github/login returns (GithubLoginResponse)

	@handler githubCallback
	get /auth/github/callback (GithubCallbackInput) returns (GithubCallbackResponse)

	@handler giteeLogin
	get /auth/gitee/login returns (GiteeLoginResponse)

	@handler giteeCallback
	get /auth/gitee/callback (GiteeCallbackInput) returns (GiteeCallbackResponse)
}
