// API DSL reference: https://go-zero.dev/reference/api-dsl/
syntax = "v1"

type CreateTicketInput {
	Title       string `json:"title"`
	Description string `json:"description"`
}

type Approval {
	ID         string           `json:"id"`
	ThreadID   string           `json:"threadId"`
	RunID      string           `json:"runId"`
	ToolCallID string           `json:"toolCallId"`
	ToolName   string           `json:"toolName"`
	Arguments  CreateTicketInput `json:"arguments"`
	Status     string           `json:"status"`
	TicketID   string           `json:"ticketId,optional,omitempty"`
	CreatedAt  string           `json:"createdAt"`
	DecidedAt  string           `json:"decidedAt,optional,omitempty"`
}

type ApprovalListResponse {
	Approvals []Approval `json:"approvals"`
}

type ApprovalDecisionInput {
	ID string `path:"id"`
}

@server(
	jwt: Auth
)
service nexus-api {
	@handler listApprovals
	get /approvals returns (ApprovalListResponse)

	@handler approveApproval
	post /approvals/:id/approve (ApprovalDecisionInput) returns (Approval)

	@handler rejectApproval
	post /approvals/:id/reject (ApprovalDecisionInput) returns (Approval)
}
