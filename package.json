{
  "name": "nexus-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev:api": "cd services/api && go run .",
    "test:api": "cd services/api && go test ./...",
    "dev:runtime": "pnpm --filter agent-runtime dev",
    "build:runtime": "pnpm --filter agent-runtime build",
    "test:runtime": "pnpm --filter agent-runtime run test",
    "typecheck:runtime": "pnpm --filter agent-runtime run typecheck",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "test:web": "pnpm --filter web test",
    "lint:web": "pnpm --filter web lint",
    "dev:admin": "pnpm --filter admin dev",
    "build:admin": "pnpm --filter admin build",
    "test:admin": "pnpm --filter admin test",
    "lint:admin": "pnpm --filter admin lint",
    "openapi:admin": "pnpm --filter admin openapi",
    "generate:contracts": "node scripts/generate-openapi.mjs && pnpm openapi:admin",
    "check:contracts": "node scripts/check-contracts.mjs",
    "doctor:admin": "pnpm --filter admin run doctor"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
