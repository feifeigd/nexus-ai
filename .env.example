# 默认使用 Mock Agent，不需要模型密钥。
NEXUS_AGENT_MODE=mock

# 切换为 OpenAI 兼容的 /chat/completions 流式接口时设置：
# NEXUS_AGENT_MODE=openai
# NEXUS_OPENAI_BASE_URL=https://api.openai.com/v1
# NEXUS_OPENAI_API_KEY=replace-with-your-key
# NEXUS_OPENAI_MODEL=your-model-name

# 本地兼容服务可以不设置 NEXUS_OPENAI_API_KEY。

# Admin 使用独立 Copilot Runtime，默认仅监听本机 4000 端口。
NEXUS_COPILOT_RUNTIME_HOST=127.0.0.1
NEXUS_COPILOT_RUNTIME_PORT=4000
NEXUS_COPILOT_RUNTIME_PROXY_TARGET=http://127.0.0.1:4000
NEXUS_AG_UI_AGENT_URL=http://127.0.0.1:8080/ag-ui
