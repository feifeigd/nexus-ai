// API DSL reference: https://go-zero.dev/reference/api-dsl/
syntax = "v1"

type Machine {
	ID             string `json:"id"`
	Name           string `json:"name,optional,omitempty"`
	PrivateAddress string `json:"privateAddress"`
	PublicAddress  string `json:"publicAddress,optional,omitempty"`
	Region         string `json:"region,optional,omitempty"`
	RootPublicKey  string `json:"rootPublicKey,optional,omitempty"`
	JoinedK8s      bool   `json:"joinedK8s"`
	CreatedAt      string `json:"createdAt"`
	UpdatedAt      string `json:"updatedAt"`
}

type CreateMachineInput {
	Name           string `json:"name,optional"`
	PrivateAddress string `json:"privateAddress"`
	PublicAddress  string `json:"publicAddress,optional"`
	Region         string `json:"region,optional"`
	RootPublicKey  string `json:"rootPublicKey,optional"`
	JoinedK8s      bool   `json:"joinedK8s,optional"`
}

type UpdateMachineInput {
	ID             string `path:"id"`
	Name           string `json:"name,optional"`
	PrivateAddress string `json:"privateAddress"`
	PublicAddress  string `json:"publicAddress,optional"`
	Region         string `json:"region,optional"`
	RootPublicKey  string `json:"rootPublicKey,optional"`
	JoinedK8s      bool   `json:"joinedK8s,optional"`
}

type DeleteMachineInput {
	ID string `path:"id"`
}

type DeleteMachineResponse {
	ID string `json:"id"`
}

type ListMachinesResponse {
	Machines []Machine `json:"machines"`
}

@server(
	jwt: Auth
	middleware: StaffOnlyMiddleware
)
service nexus-api {
	@handler listMachines
	get /machines returns (ListMachinesResponse)
}

@server(
	jwt: Auth
	middleware: AdminOnlyMiddleware
)
service nexus-api {
	@handler createMachine
	post /machines (CreateMachineInput) returns (Machine)

	@handler updateMachine
	patch /machines/:id (UpdateMachineInput) returns (Machine)

	@handler deleteMachine
	delete /machines/:id (DeleteMachineInput) returns (DeleteMachineResponse)
}
