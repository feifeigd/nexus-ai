// API DSL reference: https://go-zero.dev/reference/api-dsl/
syntax = "v1"

type IngestDocumentInput {
	Title   string `json:"title"`
	Content string `json:"content"`
}

type IngestDocumentResponse {
	DocumentID string `json:"documentId"`
}

type KnowledgeDocument {
	DocumentID string `json:"documentId"`
	Title      string `json:"title"`
	CreatedAt  string `json:"createdAt"`
	UpdatedAt  string `json:"updatedAt"`
}

type ListKnowledgeDocumentsResponse {
	Documents []KnowledgeDocument `json:"documents"`
}

service nexus-api {
	@handler listKnowledgeDocuments
	get /knowledge/documents returns (ListKnowledgeDocumentsResponse)

	@handler ingestDocument
	post /knowledge/documents (IngestDocumentInput) returns (IngestDocumentResponse)
}
