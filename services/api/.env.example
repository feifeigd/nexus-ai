# go-zero 本地配置；复制为 services/api/.env。
# 生产环境通过 Kubernetes ConfigMap 与 Secret 注入，不要共享前端配置。

NEXUS_AGENT_MODE=mock

# 对话模型：OpenAI 兼容 Chat Completions 服务。
NEXUS_OPENAI_BASE_URL=https://api.openai.com/v1
NEXUS_OPENAI_API_KEY=replace-with-your-key
NEXUS_OPENAI_MODEL=your-model-name

# 嵌入模型：可使用另一个 OpenAI 兼容提供商、密钥和模型。
# 不设置 EMBEDDING_BASE_URL 时，复用对话模型的提供商配置。
NEXUS_OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
NEXUS_OPENAI_EMBEDDING_API_KEY=replace-with-your-key
NEXUS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 配置后使用 PostgreSQL 持久化审批、工单和知识库，并启用 pgvector 检索。
# 留空则使用 SQLite 共享内存数据源；SQLite 支持开发导入，但不支持向量检索。
NEXUS_POSTGRES_DSN=postgres://nexus:nexus_local_password@127.0.0.1:5432/nexus_ai?sslmode=disable

# 认证：JWT 签名密钥（生产必须覆盖，且长度 >= 8）。
NEXUS_AUTH_SECRET=nexus-dev-secret-123

# 启动时 seed 的内部账号密码；未设置则跳过对应账号。
NEXUS_ADMIN_PASSWORD=123456
NEXUS_AUDITOR_PASSWORD=123456
NEXUS_READONLY_PASSWORD=123456

# GitHub OAuth（三方登录），申请见 docs/github-oauth-app.md。
NEXUS_GITHUB_CLIENT_ID=
NEXUS_GITHUB_CLIENT_SECRET=
NEXUS_GITHUB_REDIRECT_URI=http://localhost:8080/auth/github/callback

# Gitee 码云 OAuth，申请见 docs/gitee-oauth-app.md。
NEXUS_GITEE_CLIENT_ID=
NEXUS_GITEE_CLIENT_SECRET=
NEXUS_GITEE_REDIRECT_URI=http://localhost:8080/auth/gitee/callback

# 三方登录成功后跳回 Web 的地址。
NEXUS_WEB_BASE_URL=http://localhost:3000

# 设为 true 开启语义级事实核验（LLM 判定，会带来额外模型调用与成本）。
NEXUS_KNOWLEDGE_SEMANTIC_CHECK=
