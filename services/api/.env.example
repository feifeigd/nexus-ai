# go-zero 本地配置；复制为 services/api/.env。
# 生产环境通过 Kubernetes ConfigMap 与 Secret 注入，不要共享前端配置。

NEXUS_AGENT_MODE=mock
NEXUS_OPENAI_BASE_URL=https://api.openai.com/v1
NEXUS_OPENAI_API_KEY=replace-with-your-key
NEXUS_OPENAI_MODEL=your-model-name

# 可选：配置后使用 PostgreSQL 持久化审批和工单；留空则使用内存存储。
NEXUS_POSTGRES_DSN=postgres://nexus:nexus_local_password@127.0.0.1:5432/nexus_ai?sslmode=disable
